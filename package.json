{
    "name": "pi-delta",
    "version": "0.1.0",
    "description": "Share Pi coding agent sessions as multiplayer Delta threads",
    "private": true,
    "type": "module",
    "keywords": [
        "pi-package"
    ],
    "pi": {
        "extensions": [
            "./src/index.ts"
        ]
    },
    "scripts": {
        "lint": "oxlint src",
        "test": "bun test src",
        "check": "tsc -p tsconfig.json && bun run test"
    },
    "devDependencies": {
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@types/bun": "1.2.21",
        "@types/node": "22.19.19",
        "oxlint": "^1.79.0",
        "typescript": "5.9.3",
        "typebox": "1.3.27"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "typebox": "*"
    }
}
